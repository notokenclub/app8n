# ---------------------------------------------------------------------------
# app8n — copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Local-first by default. Point at Postgres/Supabase to run against a server.
DATABASE_URL="file:./data/app8n.db"

# Master key for the AES-256-GCM credential vault.
# Generate with: npm run vault:keygen
# Losing this key makes every stored credential unrecoverable.
APP8N_ENCRYPTION_KEY=""

# --- Google Workspace OAuth (Phase 2) --------------------------------------
# Create an OAuth 2.0 Web Application client at console.cloud.google.com,
# enable the Gmail, Calendar, Drive, Sheets, Docs and Tasks APIs, and add the
# redirect URI below to the client's authorised list.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# --- Agent model provider --------------------------------------------------
# The agent runs on one provider at a time. Set a key for the one you want and
# app8n picks it up automatically; you only need APP8N_MODEL_PROVIDER when both
# keys are present and you want to force a choice.
#
#   anthropic  paid.  Key: https://console.anthropic.com/settings/keys
#   google     free tier.  Key: https://aistudio.google.com/apikey
APP8N_MODEL_PROVIDER=""

ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Overrides the provider's default model (claude-opus-4-7 / gemini-2.5-flash).
APP8N_MODEL_ID=""

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"

# Single implicit owner for the local-first backend.
APP8N_LOCAL_USER_EMAIL="local@app8n.local"

# Swap the Google clients for in-memory fixtures. Lets every connector and
# blueprint run with no credentials and no network. Set to 1 for development.
APP8N_MOCK_GOOGLE="0"

# --- Mobile (Capacitor) ----------------------------------------------------
# Backend the native shell loads. Use your machine's LAN IP when testing on a
# real device — localhost resolves to the phone itself. Read at `cap sync` time.
APP8N_SERVER_URL="http://localhost:3000"

# Backend the browser/native client calls. Leave blank for same-origin web.
NEXT_PUBLIC_APP8N_API_URL=""

# Deep link the backend redirects to after mobile OAuth completes. Its scheme
# is written into the native projects by `npm run cap:sync`, so the two cannot
# drift; change it here rather than in Info.plist or AndroidManifest.xml.
APP8N_MOBILE_REDIRECT_URI="app8n://auth/callback"

# --- Push notifications ----------------------------------------------------
# Delivers approval gates raised by scheduled runs to your phone. Without it
# the Approvals tab is the only channel, which is fine on a machine you watch.
# A Firebase service account, either inline JSON or a path to the key file.
APP8N_FCM_SERVICE_ACCOUNT=""
